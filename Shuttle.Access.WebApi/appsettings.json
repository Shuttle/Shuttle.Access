{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System.Net.Http": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/.log",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 1048576,
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Shuttle": {
    "Access": {
      "Api": {
        "AllowPasswordAuthentication": true,
        "OAuthRegisterUnknownIdentities": true
      }
    },
    "Hopper": {
      "AzureStorageQueues": {
        "azure": {
          "ConnectionString": "UseDevelopmentStorage=true"
        }
      },
      "Inbox": {
        "WorkTransportUri": "azuresq://azure/access-webapi-inbox-work",
        "DeferredTransportUri": "azuresq://azure/access-webapi-inbox-deferred",
        "ErrorTransportUri": "azuresq://azure/shuttle-error",
        "ThreadCount": 1,
        "IgnoreOnFailureDurations": [
          "00:00:05",
          "00:00:10",
          "00:00:30"
        ]
      },
      "MessageRoutes": [
        {
          "Uri": "azuresq://azure/access-server-inbox-work",
          "Specifications": [
            {
              "Name": "StartsWith",
              "Value": "Shuttle.Access.Messages"
            }
          ]
        }
      ],
      "RabbitMQ.ignore": {
        ".": {
          "Host": "localhost",
          "VirtualHost": "/",
          "Username": "guest",
          "Password": "guest"
        }
      },
      "Inbox.ignore": {
        "WorkTransportUri": "rabbitmq://./access-webapi-inbox-work",
        "DeferredTransportUri": "rabbitmq://./access-webapi-inbox-deferred",
        "ErrorTransportUri": "rabbitmq://./shuttle-error",
        "ThreadCount": 1,
        "IgnoreOnFailureDurations": [
          "00:00:05",
          "00:00:10",
          "00:00:30"
        ]
      },
      "MessageRoutes.ignore": [
        {
          "Uri": "rabbitmq://./access-server-inbox-work",
          "Specifications": [
            {
              "Name": "StartsWith",
              "Value": "Shuttle.Access.Messages"
            }
          ]
        }
      ]
    },
    "Recall": {
      "EventStore": {
        "PrimitiveEventSequencerIdleDurations": [
          "00:00:01"
        ]
      },
      "EventProcessing": {
        "AutoStart": true,
        "ImmediateConsistency": {
          "Enabled": true
        },
        "ProjectionProcessorIdleDurations": [
          "00:00:01"
        ],
        "ProjectionThreadCount": 1
      }
    }
  }
}
